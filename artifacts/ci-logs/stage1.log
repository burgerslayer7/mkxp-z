	echo "#define $func_type \"$(od -N 32 -x /dev/urandom | cut -b 9- | tr -d ' \n' | sed -e 's/.\{2\}/\\x&/g')\"" >> /home/runner/work/mkxp-z/mkxp-z/libretro/build/libretro-stage1/ruby/mkxp-sandbox-ruby-func-types.h; \
done
